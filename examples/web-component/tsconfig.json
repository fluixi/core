{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "@fluixi/jsx",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"]
  },
  "include": ["src", "tests", "fluixi.config.ts", "fluixi.d.ts"],
  "references": [
    {
      "path": "../../packages/web-components"
    },
    {
      "path": "../../packages/server"
    },
    {
      "path": "../../packages/jsx"
    },
    {
      "path": "../../packages/core"
    },
    {
      "path": "../../packages/cli"
    },
    {
      "path": "../../packages/reactive"
    },
    {
      "path": "../../packages/dom"
    },
    {
      "path": "../../packages/start"
    }
  ]
}
