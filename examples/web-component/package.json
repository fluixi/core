{
  "name": "@fluixi/example-web-component",
  "version": "0.0.2-alpha.5",
  "private": true,
  "type": "module",
  "description": "Two custom elements built with @fluixi/web-components, shipped as portable files.",
  "scripts": {
    "build": "fluixi build --format=web-component",
    "build:shared": "fluixi build --format=fluixi",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fluixi/cli": "workspace:*",
    "@fluixi/dom": "workspace:*",
    "@fluixi/jsx": "workspace:*",
    "@fluixi/reactive": "workspace:*",
    "@fluixi/start": "workspace:*",
    "@fluixi/web-components": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^25.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "svelte": "^5.57.1",
    "vite": "^5.0.0",
    "vitest": "^1.6.1",
    "vue": "^3.5.43"
  },
  "nx": {
    "targets": {
      "test": {
        "dependsOn": [
          "build"
        ]
      }
    }
  }
}
