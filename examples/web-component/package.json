{
  "name": "@fluixi/example-web-component",
  "version": "0.0.2-alpha.26",
  "private": true,
  "type": "module",
  "description": "Custom elements built with @fluixi/web-components: portable files for any page, and the same elements inside a Fluixi app.",
  "scripts": {
    "dev": "fluixi dev",
    "build": "fluixi build --format=web-component",
    "build:shared": "fluixi build --format=fluixi",
    "demo": "vite --open /demo/",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fluixi/cli": "workspace:*",
    "@fluixi/core": "workspace:*",
    "@fluixi/dom": "workspace:*",
    "@fluixi/jsx": "workspace:*",
    "@fluixi/reactive": "workspace:*",
    "@fluixi/server": "workspace:*",
    "@fluixi/start": "workspace:*",
    "@fluixi/web-components": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^25.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "svelte": "^5.57.1",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue": "^3.5.43"
  },
  "nx": {
    "targets": {
      "test": {
        "dependsOn": [
          "build"
        ]
      }
    }
  }
}
