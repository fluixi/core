{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "jsxImportSource": "@fluixi/jsx",
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": ["src", "fluixi.config.mjs", "fluixi.d.ts", "vite.config.ts"],
  "references": [
    {
      "path": "../../packages/jsx"
    },
    {
      "path": "../../packages/server"
    },
    {
      "path": "../../packages/dom"
    },
    {
      "path": "../../packages/reactive"
    },
    {
      "path": "../../packages/core"
    },
    {
      "path": "../../packages/cli"
    },
    {
      "path": "../../packages/start"
    }
  ]
}
