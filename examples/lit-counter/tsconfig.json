{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vite/client"],
    "plugins": [{ "name": "@fluixi/ts-plugin" }]
  },
  "include": ["src", "fluixi.d.ts"],
  "references": [
    {
      "path": "../../packages/reactive"
    },
    {
      "path": "../../packages/server"
    },
    {
      "path": "../../packages/core"
    },
    {
      "path": "../../packages/dom"
    },
    {
      "path": "../../packages/vite-plugin"
    },
    {
      "path": "../../packages/ts-plugin"
    }
  ]
}
