{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "jsxImportSource": "@fluixi/jsx",
    "resolveJsonModule": true,
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": ["src"],
  "references": [
    {
      "path": "../../packages/reactive"
    },
    {
      "path": "../../packages/core"
    },
    {
      "path": "../../packages/jsx"
    },
    {
      "path": "../../packages/dom"
    },
    {
      "path": "../../packages/vite-plugin"
    }
  ]
}
