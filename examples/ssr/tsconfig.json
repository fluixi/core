{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "jsxImportSource": "@fluixi/kettlejs",
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": ["src", "server.mjs"],
  "references": [
    { "path": "../../packages/reactive" },
    { "path": "../../packages/kettlejs" },
    { "path": "../../packages/jsx-runtime" },
    { "path": "../../packages/dom" },
    { "path": "../../packages/server" },
    { "path": "../../packages/vite-plugin" }
  ]
}
