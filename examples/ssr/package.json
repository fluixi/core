    "build": "vite build",
    "serve": "node server.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fluixi/dom": "workspace:*",
    "@fluixi/jsx": "workspace:*",
    "@fluixi/core": "workspace:*",
    "@fluixi/reactive": "workspace:*",
    "@fluixi/server": "workspace:*"
  },
  "devDependencies": {
    "@fluixi/vite-plugin": "workspace:*",
    "jsdom": "^25.0.0",
    "vite": "^5.0.0",
    "vitest": "^1.6.1"
  }
}
