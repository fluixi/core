{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "jsxImportSource": "@fluixi/jsx",
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": [
    "src",
    "tests",
    "fluixi.config.ts",
    "vite.config.ts",
    "fluixi.d.ts"
  ],
  "references": [
    {
      "path": "../../packages/session"
    },
    {
      "path": "../../packages/server"
    },
    {
      "path": "../../packages/jsx"
    },
    {
      "path": "../../packages/head"
    },
    {
      "path": "../../packages/cli"
    },
    {
      "path": "../../packages/auth"
    },
    {
      "path": "../../packages/reactive"
    },
    {
      "path": "../../packages/dom"
    },
    {
      "path": "../../packages/core"
    },
    {
      "path": "../../packages/start"
    }
  ]
}
