
# Introspection and revocation authenticate the caller. A client with a shared secret uses
# <PROVIDER>_CLIENT_SECRET; one registered with a public key names its private JWK instead.
# Prefix either with <PROVIDER>_INTROSPECT_ to have a different client ask.
OKTA_PRIVATE_KEY=~/.config/fluixi/okta-private.jwk.json
OKTA_KEY_ID=
