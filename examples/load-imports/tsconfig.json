{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "@fluixi/jsx",
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "vite/client"
    ],
    "lib": [
      "dom",
      "DOM.Iterable",
      "es2022"
    ],
    "noEmit": true
  },
  "include": [
    "src",
    "fluixi.d.ts"
  ],
  "references": [
    {
      "path": "../../packages/reactive"
    },
    {
      "path": "../../packages/jsx"
    },
    {
      "path": "../../packages/dom"
    },
    {
      "path": "../../packages/core"
    },
    {
      "path": "../../packages/vite-plugin"
    },
    {
      "path": "../../packages/compiler"
    }
  ]
}
