  },
  "devDependencies": {
    "@fluixi/ts-plugin": "workspace:*",
    "@fluixi/vite-plugin": "workspace:*",
    "jsdom": "^25.0.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
