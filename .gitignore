# Don't commit npm/yarn lockfiles — this repo uses pnpm
package-lock.json
yarn.lock

# ─── Environment & secrets ────────────────────────────────────────────────────
# Rule: commit *.example / *.docker templates, never the real values.
.env
.env.local
.env.*.local
.env.production
.env.staging
.env.development

# Docker local overrides (real credentials, never commit)
.env.docker.local

# Private keys, certs
*.pem
*.key
*.cert
*.p12
*.pfx
secrets/
.secrets/

# ─── Caches ───────────────────────────────────────────────────────────────────
.nx/cache
.nx/workspace-data
.vite/
.vite-cache/
.cache/
vite.config.*.timestamp*
vitest.config.*.timestamp*

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
/coverage
/libpeerconnection.log
testem.log

# ─── IDEs & editors ───────────────────────────────────────────────────────────
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# VSCode — commit shared settings, ignore personal/local overrides
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Cursor / AI tools
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

