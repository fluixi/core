{
  "manifest_version": 3,
  "name": "Fluixi devtools",
  "version": "0.1.0",
  "description": "Inspect a Fluixi application's reactive graph.",
  "devtools_page": "devtools.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/agent.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
