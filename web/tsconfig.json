{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "jsxImportSource": "@fluixi/jsx",
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"]
  },
  "include": ["src"],
  "references": [
    {
      "path": "../packages/server"
    },
    {
      "path": "../packages/reactive"
    },
    {
      "path": "../packages/jsx"
    },
    {
      "path": "../packages/dom"
    },
    {
      "path": "../packages/core"
    },
    {
      "path": "../packages/cli"
    },
    {
      "path": "../packages/start"
    }
  ]
}
