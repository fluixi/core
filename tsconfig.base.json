{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["development"],
    "paths": {
      "@awc/kettlejs/rx": ["./packages/kettlejs/src/lib/server/reactive.js"],
      "@awc/kettlejs/rx/*": ["./packages/kettlejs/src/lib/server/*.js"],
      "@awc/reactive": ["./packages/reactive/lib/index.js"],
      "@awc/reactive/*": ["./packages/reactive/lib/*.js"],
      "@awc/utils": ["./packages/utils/src/index.js"],
      "@awc/utils/*": ["./packages/utils/*.js"]
    }
  }
}
