{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": [
      "es2022"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": [
      "development"
    ],
    "paths": {
      "@fluixi/reactive": [
        "./packages/reactive/lib/index.js"
      ],
      "@fluixi/reactive/*": [
        "./packages/reactive/lib/*.js"
      ],
      "@fluixi/utils": [
        "./packages/utils/src/index.js"
      ],
      "@fluixi/utils/*": [
        "./packages/utils/*.js"
      ]
    }
  }
}
