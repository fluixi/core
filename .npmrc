# Default registry for public packages
registry=https://registry.npmjs.org/

# @fluixi scoped packages → GitHub Packages (github.com/fluixi org)
# Auth token goes in ~/.npmrc (local) or NODE_AUTH_TOKEN env var (CI / Cloudflare build).
@fluixi:registry=https://npm.pkg.github.com/
@bambiste:registry=https://npm.pkg.github.com/
# When NODE_AUTH_TOKEN is set (CI, Cloudflare Pages) it authenticates the private installs;
# when unset (local devs using ~/.npmrc) pnpm warns and falls back — harmless.
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
