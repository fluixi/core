# Default registry — public npm.
registry=https://registry.npmjs.org/

# @fluixi packages publish to (and install from) public npm.
# Auth is only needed to PUBLISH (CI); public installs need no token.
@fluixi:registry=https://registry.npmjs.org/
//registry.npmjs.org/:_authToken=${NPM_TOKEN}

# @bambiste build tooling (mix-builder) still lives on GitHub Packages. This is a
# build-time devDependency only — consumers of @fluixi/* never touch it.
# Auth goes in ~/.npmrc (local) or NODE_AUTH_TOKEN (CI); unset locally → pnpm warns, harmless.
@bambiste:registry=https://npm.pkg.github.com/
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
