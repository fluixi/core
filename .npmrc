# Default registry — public npm.
registry=https://registry.npmjs.org/

# @fluixi and @bambiste both publish to public npm, so no scope routing is needed
# (the default registry above covers them). Auth tokens do NOT live here — pnpm v10+
# ignores _authToken lines in a committed project .npmrc; put them in ~/.npmrc.
@fluixi:registry=https://registry.npmjs.org/
