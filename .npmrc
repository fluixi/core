# Default registry — public npm.
registry=https://registry.npmjs.org/

# Registry routing only. Auth tokens do NOT live here: pnpm (v10+) ignores
# _authToken lines in a committed project .npmrc (they can't be safely expanded).
# Put auth in a trusted source instead — your user-level ~/.npmrc locally, or the
# "Configure registry auth" step in CI (see .github/workflows/release.yml).
@fluixi:registry=https://registry.npmjs.org/
@bambiste:registry=https://npm.pkg.github.com/
