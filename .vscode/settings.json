{
  "js/ts.tsserver.experimental.enableProjectDiagnostics": false,
  "js/ts.tsserver.automaticTypeAcquisition.enabled": false,
  "js/ts.tsserver.maxMemory": 8192,
  "eslint.enable": false,
  "eslint.run": "onSave",
  "eslint.probe": ["typescript", "typescriptreact"],
  "js/ts.tsserver.log": "off",
  "js/ts.tsserver.useSyntaxServer": "auto",
  "typescript.tsconfig": "tsconfig.json",
  "js/ts.preferences.autoImportFileExcludePatterns": ["**/node_modules/@types/**"],
  "js/ts.tsserver.watchOptions": {
    "excludeDirectories": ["**/.nx/**", "**/node_modules/**", "**/dist/**"]
  },
  "files.watcherExclude": {
    "**/.nx/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true
  },
  "search.exclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/.nx/**": true
  },
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/.nx/**": true
  },
  "lit-html.tags": ["html", "raw"],
  "lit-html.format.enabled": true,
  "js/ts.tsdk.path": "node_modules/typescript/lib"
}
