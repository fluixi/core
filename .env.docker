# ─── Leuzman Full Stack — Docker environment ──────────────────────────────────
#
# Commit this template. Copy to .env.docker.local and fill in real values
# before deploying to a VPS (never commit .env.docker.local).
#
# Usage:
#   Local:  docker compose --env-file .env.docker up --build -d
#   VPS:    docker compose --env-file .env.docker.local up -d

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=medusa-store
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ── Medusa ────────────────────────────────────────────────────────────────────
MEDUSA_PORT=9000
NODE_ENV=production

# Secrets — CHANGE THESE before deploying
JWT_SECRET=change-me-in-production
COOKIE_SECRET=change-me-in-production

# ── CORS — update with real domains on VPS ────────────────────────────────────
# Local
STORE_CORS=http://localhost:3003,http://localhost:3004
ADMIN_CORS=http://localhost:3004,http://localhost:9000
AUTH_CORS=http://localhost:3003,http://localhost:3004,http://localhost:9000
# VPS example:
# STORE_CORS=https://leuzma.com,https://admin.leuzma.com
# ADMIN_CORS=https://admin.leuzma.com,https://api.leuzma.com
# AUTH_CORS=https://leuzma.com,https://admin.leuzma.com,https://api.leuzma.com

# ── Admin seed credentials ────────────────────────────────────────────────────
ADMIN_EMAIL=admin@leuzma.com
ADMIN_PASSWORD=Admin@1234

# ── Storefront & Store Admin ──────────────────────────────────────────────────
# URL the BROWSER uses to reach Medusa — not the Docker internal URL.
# Local:   http://localhost:9000
# VPS:     https://api.leuzma.com
VITE_MEDUSA_URL=http://localhost:9000

# Generated by Medusa on first seed — leave empty on first run.
# After first `docker compose up`, run:
#   docker compose logs medusa | grep "Publishable API key"
# then fill in the key here and restart the frontend services.
VITE_PUBLISHABLE_KEY=

# ── Ports ─────────────────────────────────────────────────────────────────────
STOREFRONT_PORT=3003
ADMIN_PORT=3004
