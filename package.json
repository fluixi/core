{
  "name": "fluixi-core",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" --workspace-concurrency=1 run build",
    "build:all": "nx run-many -t build --parallel=false",
    "lint": "nx affected -t lint",
    "test": "nx affected -t test",
    "publish:packages": "nx run-many -t publish --parallel=false",
    "changeset": "changeset",
    "version": "changeset version && node scripts/gen-versions.mjs",
    "release": "pnpm run build && changeset publish"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@changesets/cli": "^2.31.0",
    "@nx/js": "21.4.0",
    "@nx/vite": "21.4.0",
    "@nx/web": "21.4.0",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@types/node": "18.16.9",
    "@typescript/native-preview": "7.0.0-dev.20260430.1",
    "@vitest/coverage-v8": "^3.0.5",
    "@vitest/ui": "^5.0.3",
    "cross-env": "^10.1.0",
    "jiti": "2.4.2",
    "jsdom": "^27.2.0",
    "mappel": "0.1.0",
    "nx": "21.4.0",
    "prettier": "^2.6.2",
    "tslib": "^2.3.0",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "chalk": "^5.6.2"
  }
}
