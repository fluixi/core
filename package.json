{
  "name": "fluixi-core",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "nx run-many -t build -p @fluixi/utils @fluixi/reactive @fluixi/dom @fluixi/babel-plugin-jsx @fluixi/element @fluixi/jsx-runtime @fluixi/kettlejs --parallel=false",
    "build:all": "nx run-many -t build --parallel=false",
    "lint": "nx affected -t lint",
    "test": "nx affected -t test",
    "publish:packages": "nx run-many -t publish --parallel=false",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm run build && changeset publish"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@changesets/cli": "^2.31.0",
