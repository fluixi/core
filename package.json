{
  "name": "@awc/reactive",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "artifact:auth": "npx google-artifactregistry-auth --repo-config=./.npmrc --credential-config=./.npmrc && npm run share:auth",
    "share:auth": "cp .npmrc ~/npm-artifacts/.npmrc",
    "artifact:copy": "cp ~/npm-artifacts/.npmrc .npmrc",
    "docker:up": "docker compose --env-file .env.docker up --build -d",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v",
    "docker:logs": "docker compose logs -f",
    "docker:backend": "docker compose --env-file .env.docker up --build -d postgres redis medusa",
    "docker:frontend": "docker compose --env-file .env.docker up --build -d storefront store-admin"
  },
  "private": true,
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@nx/js": "21.4.0",
    "@nx/vite": "21.4.0",
    "@nx/web": "21.4.0",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@types/node": "18.16.9",
    "@typescript/native-preview": "7.0.0-dev.20260430.1",
    "@vitest/coverage-v8": "^3.0.5",
    "@vitest/ui": "^3.0.0",
    "cross-env": "^10.1.0",
    "electron": "^33.4.11",
    "jiti": "2.4.2",
    "jsdom": "^27.2.0",
    "nx": "21.4.0",
    "prettier": "^2.6.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.3.0",
    "typescript": "~5.8.2",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@awc/kettlejs": "link:packages/kettlejs",
    "chalk": "^5.6.2",
    "log-update": "^7.0.2",
    "ora": "^9.0.0",
    "solid-js": "^1.9.10"
  }
}
