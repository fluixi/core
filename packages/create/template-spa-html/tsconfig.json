  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "plugins": [{ "name": "@fluixi/ts-plugin" }]
  },
  "include": ["src", "vite.config.ts"]
}
