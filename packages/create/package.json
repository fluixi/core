{
  "name": "create-fluixi",
  "version": "1.0.0-alpha.113",
  "license": "MIT",
  "author": "Ibrahima Touré",
  "description": "Scaffold a new Fluixi app — `npm create fluixi <dir>`.",
  "type": "module",
  "bin": {
    "create-fluixi": "./dist/index.js"
  },
  "files": [
    "dist",
    "template-ssr",
    "template-spa",
    "template-ssr-html",
    "template-spa-html",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json && esbuild src/index.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist/index.js",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fluixi/core.git",
    "directory": "packages/create"
  },
  "devDependencies": {
    "@fluixi/cli": "workspace:*",
    "@fluixi/compiler": "workspace:*",
    "esbuild": "^0.24.0",
    "vitest": "^5.0.3"
  },
  "nx": {
    "targets": {
      "test": {
        "dependsOn": [
          "build"
        ]
      }
    }
  }
}
