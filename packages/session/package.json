{
  "name": "@fluixi/session",
  "version": "1.0.0-alpha.115",
  "license": "MIT",
  "author": "Ibrahima Touré",
  "private": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs",
        "default": "./dist/index.js"
      },
      "./server": {
        "types": "./dist/server.d.ts",
        "import": "./dist/server.mjs",
        "require": "./dist/server.cjs",
        "default": "./dist/server.js"
      }
    }
  },
  "description": "Client-side session lifecycle for Fluixi — createSession: bring a backend adapter, get token/user signals, isAuthenticated, persistence, hydrate and automatic token refresh. (The full server-first auth engine lives in @fluixi/auth.)",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./server": {
      "development": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.cjs",
      "default": "./dist/server.js"
    }
  },
  "scripts": {
    "build:typings": "tsc -p tsconfig.lib.json",
    "build": "cross-env NODE_ENV=production mix-builder",
    "dev": "tsc -w -p tsconfig.lib.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@bambiste/mix-builder": "^0.5.0",
    "@fluixi/core": "workspace:*",
    "@fluixi/reactive": "workspace:*",
    "@fluixi/storage": "workspace:*",
    "cross-env": "^7.0.3",
    "inquirer": "^14.0.2"
  },
  "peerDependencies": {
    "@fluixi/core": "workspace:^",
    "@fluixi/reactive": "workspace:^",
    "@fluixi/storage": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fluixi/core.git",
    "directory": "packages/session"
  }
}
