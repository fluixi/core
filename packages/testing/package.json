{
  "name": "@fluixi/testing",
  "version": "1.0.0-alpha.105",
  "license": "MIT",
  "author": "Ibrahima Touré",
  "private": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs",
        "default": "./dist/index.js"
      }
    }
  },
  "description": "Minimal test helpers for Fluixi components — render into jsdom, flush effects, fire events. Bring vitest + @testing-library/dom for the rest.",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build:typings": "tsc -p tsconfig.lib.json",
    "build": "cross-env NODE_ENV=production mix-builder",
    "dev": "tsc -w -p tsconfig.lib.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@bambiste/mix-builder": "^0.4.0",
    "@fluixi/dom": "workspace:*",
    "@fluixi/reactive": "workspace:*",
    "cross-env": "^7.0.3",
    "inquirer": "^14.0.2"
  },
  "peerDependencies": {
    "@fluixi/dom": "workspace:^",
    "@fluixi/reactive": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fluixi/core.git",
    "directory": "packages/testing"
  }
}
