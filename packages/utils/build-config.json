{
  "$schema": "./node_modules/@bambiste/mix-builder/dist/lib/builder/schema/build-config.schema.json",
  "builder": "esbuild",
  "tsc": {
    "project": "tsconfig.lib.json"
  },
  "esbuild": {
    "extensions": [
      ".js",
      ".jsx",
      ".ts",
      ".tsx"
    ],
    "target": "es2021",
    "formats": [
      "es",
      "cjs"
    ],
    "entries": [
      "src/**/*.ts"
    ],
    "rootDir": "src",
    "clean": true,
    "banner": {
      "js": "/*! {name} v{version} | (c) {year} {author} and Fluixi contributors | {license} */",
      "include": [
        "src/index.ts",
        "src/lib/array/index.ts",
        "src/lib/color/index.ts",
        "src/lib/compare/index.ts",
        "src/lib/dom/index.ts",
        "src/lib/functions/index.ts",
        "src/lib/maths/constants.ts",
        "src/lib/maths/fn/index.ts",
        "src/lib/maths/guards.ts",
        "src/lib/maths/index.ts",
        "src/lib/maths/types/index.ts",
        "src/lib/object/index.ts",
        "src/lib/primitive/index.ts"
      ]
    }
  }
}
