{
  "name": "@fluixi/core",
  "version": "1.0.0-alpha.103",
  "license": "MIT",
  "author": "Ibrahima Touré",
  "description": "framework to build apps with DOM runtime, reactive core, router, and JSX runtime; components run once, reactivity updates DOM",
  "private": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "exports": {
      "./types": {
        "types": "./dist/fluixi.d.ts"
      },
      ".": {
        "types": "./dist/src/index.d.ts",
        "import": "./dist/src/index.mjs",
        "require": "./dist/src/index.cjs",
        "default": "./dist/src/index.js"
      },
      "./server": {
        "types": "./dist/src/lib/server/index.d.ts",
        "import": "./dist/src/lib/server/index.mjs",
        "require": "./dist/src/lib/server/index.cjs",
        "default": "./dist/src/lib/server/index.js"
      },
      "./client": {
        "types": "./dist/src/lib/client/index.d.ts",
        "import": "./dist/src/lib/client/index.mjs",
        "require": "./dist/src/lib/client/index.cjs",
        "default": "./dist/src/lib/client/index.js"
      },
      "./i18n": {
        "types": "./dist/src/lib/i18n/index.d.ts",
        "import": "./dist/src/lib/i18n/index.mjs",
        "require": "./dist/src/lib/i18n/index.cjs",
        "default": "./dist/src/lib/i18n/index.js"
      },
      "./storage": {
        "types": "./dist/src/lib/storage/index.d.ts",
        "import": "./dist/src/lib/storage/index.mjs",
        "require": "./dist/src/lib/storage/index.cjs",
        "default": "./dist/src/lib/storage/index.js"
      },
      "./routes": {
        "types": "./dist/src/routes.d.ts",
        "import": "./dist/src/routes.mjs",
        "require": "./dist/src/routes.cjs",
        "default": "./dist/src/routes.js"
      },
      "./router": {
        "types": "./dist/src/lib/router/index.d.ts",
        "import": "./dist/src/lib/router/index.mjs",
        "require": "./dist/src/lib/router/index.cjs",
        "default": "./dist/src/lib/router/index.js"
      },
      "./jsx-runtime": {
        "types": "./dist/src/lib/jsx-runtime/index.d.ts",
        "import": "./dist/src/lib/jsx-runtime/index.mjs",
        "require": "./dist/src/lib/jsx-runtime/index.cjs",
        "default": "./dist/src/lib/jsx-runtime/index.js"
      },
      "./jsx-dev-runtime": {
        "types": "./dist/src/lib/jsx-runtime/jsx-dev-runtime.d.ts",
        "import": "./dist/src/lib/jsx-runtime/jsx-dev-runtime.mjs",
        "require": "./dist/src/lib/jsx-runtime/jsx-dev-runtime.cjs",
        "default": "./dist/src/lib/jsx-runtime/jsx-dev-runtime.js"
      },
      "./plugins": {
        "types": "./dist/src/lib/plugins/index.d.ts",
        "import": "./dist/src/lib/plugins/index.mjs",
        "require": "./dist/src/lib/plugins/index.cjs",
        "default": "./dist/src/lib/plugins/index.js"
      },
      "./lib/*": "./src/lib/*",
      "./utils": {
        "types": "./dist/src/utils.d.ts",
        "import": "./dist/src/utils.mjs",
        "require": "./dist/src/utils.cjs",
        "default": "./dist/src/utils.js"
      }
    }
  },
  "type": "module",
  "main": "./src/index.ts",
  "unpkg": "./dist/cdn/core.global.js",
  "jsdelivr": "./dist/cdn/core.global.js",
  "files": [
    "dist",
    "types",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./types": {
      "development": "./types/fluixi.d.ts",
      "types": "./dist/fluixi.d.ts"
    },
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.mjs",
      "require": "./dist/src/index.cjs",
      "default": "./dist/src/index.js"
    },
    "./server": {
      "development": "./src/lib/server/index.ts",
      "types": "./dist/src/lib/server/index.d.ts",
      "import": "./dist/src/lib/server/index.mjs",
      "require": "./dist/src/lib/server/index.cjs",
      "default": "./dist/src/lib/server/index.js"
    },
    "./client": {
      "development": "./src/lib/client/index.ts",
      "types": "./dist/src/lib/client/index.d.ts",
      "import": "./dist/src/lib/client/index.mjs",
      "require": "./dist/src/lib/client/index.cjs",
      "default": "./dist/src/lib/client/index.js"
    },
    "./i18n": {
      "development": "./src/lib/i18n/index.ts",
      "types": "./dist/src/lib/i18n/index.d.ts",
      "import": "./dist/src/lib/i18n/index.mjs",
      "require": "./dist/src/lib/i18n/index.cjs",
      "default": "./dist/src/lib/i18n/index.js"
    },
    "./storage": {
      "development": "./src/lib/storage/index.ts",
      "types": "./dist/src/lib/storage/index.d.ts",
      "import": "./dist/src/lib/storage/index.mjs",
      "require": "./dist/src/lib/storage/index.cjs",
      "default": "./dist/src/lib/storage/index.js"
    },
    "./routes": {
      "development": "./src/routes.ts",
      "types": "./dist/src/routes.d.ts",
      "import": "./dist/src/routes.mjs",
      "require": "./dist/src/routes.cjs",
      "default": "./dist/src/routes.js"
    },
    "./router": {
      "development": "./src/lib/router/index.ts",
      "types": "./dist/src/lib/router/index.d.ts",
      "import": "./dist/src/lib/router/index.mjs",
      "require": "./dist/src/lib/router/index.cjs",
      "default": "./dist/src/lib/router/index.js"
    },
    "./jsx-runtime": {
      "development": "./src/lib/jsx-runtime/index.ts",
      "types": "./dist/src/lib/jsx-runtime/index.d.ts",
      "import": "./dist/src/lib/jsx-runtime/index.mjs",
      "require": "./dist/src/lib/jsx-runtime/index.cjs",
      "default": "./dist/src/lib/jsx-runtime/index.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/src/lib/jsx-runtime/jsx-dev-runtime.d.ts",
      "import": "./dist/src/lib/jsx-runtime/jsx-dev-runtime.mjs",
      "require": "./dist/src/lib/jsx-runtime/jsx-dev-runtime.cjs",
      "default": "./dist/src/lib/jsx-runtime/jsx-dev-runtime.js"
    },
    "./plugins": {
      "development": "./src/lib/plugins/index.ts",
      "types": "./dist/src/lib/plugins/index.d.ts",
      "import": "./dist/src/lib/plugins/index.mjs",
      "require": "./dist/src/lib/plugins/index.cjs",
      "default": "./dist/src/lib/plugins/index.js"
    },
    "./lib/*": "./src/lib/*",
    "./utils": {
      "development": "./src/utils.ts",
      "types": "./dist/src/utils.d.ts",
      "import": "./dist/src/utils.mjs",
      "require": "./dist/src/utils.cjs",
      "default": "./dist/src/utils.js"
    }
  },
  "scripts": {
    "build:typings": "tsc -p tsconfig.lib.json",
    "build": "node ../../scripts/gen-version.mjs && cross-env NODE_ENV=production mix-builder && cp types/fluixi.d.ts dist/fluixi.d.ts && pnpm run build:cdn",
    "build:cdn": "cross-env NODE_ENV=production mix-builder --buildConfigFile=build-config.cdn.json",
    "send": "mix-publisher --scoped --buildConfigFileConfig=publish-config.json",
    "pack": "pnpm pack",
    "artifact:copy": "cp ~/npm-artifacts/.npmrc .npmrc",
    "test": "vitest",
    "lint": "eslint src --ext ts,tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@fluixi/utils": "workspace:^"
  },
  "devDependencies": {
    "@bambiste/mix-builder": "^0.4.0",
    "@fluixi/compiler": "workspace:*",
    "@fluixi/dom": "workspace:*",
    "@fluixi/head": "workspace:*",
    "@fluixi/jsx": "workspace:*",
    "@fluixi/reactive": "workspace:*",
    "@fluixi/router": "workspace:*",
    "@fluixi/server": "workspace:*",
    "@fluixi/storage": "workspace:*",
    "@fluixi/vite-plugin": "workspace:*",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.9",
    "chalk": "^5.3.0",
    "commander": "^11.0.0",
    "esbuild": "^0.27.1",
    "execa": "^9.6.1",
    "fs-extra": "^11.3.3",
    "inquirer": "^9.3.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vite-plugin-node-polyfills": "^0.25.0",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fluixi/core.git",
    "directory": "packages/core"
  },
  "peerDependencies": {
    "@fluixi/compiler": "workspace:^",
    "@fluixi/dom": "workspace:^",
    "@fluixi/head": "workspace:^",
    "@fluixi/jsx": "workspace:^",
    "@fluixi/reactive": "workspace:^",
    "@fluixi/router": "workspace:^",
    "@fluixi/server": "workspace:^",
    "@fluixi/storage": "workspace:^",
    "@fluixi/vite-plugin": "workspace:^",
    "vite-plugin-node-polyfills": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "@fluixi/compiler": {
      "optional": true
    },
    "@fluixi/vite-plugin": {
      "optional": true
    },
    "vite-plugin-node-polyfills": {
      "optional": true
    }
  }
}
