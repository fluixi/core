{
  "$schema": "./node_modules/@bambiste/mix-builder/dist/lib/builder/schema/build-config.schema.json",
  "builder": "esbuild",
  "tsc": {
    "project": "tsconfig.lib.json"
  },
  "esbuild": {
    "extensions": [
      ".js",
      ".jsx",
      ".ts",
      ".tsx"
    ],
    "target": "es2022",
    "formats": [
      "es",
      "cjs"
    ],
    "entries": [
      "src/**/*.ts"
    ],
    "rootDir": "./",
    "externals": [
      "@fluixi/reactive",
      "@fluixi/reactive/signal",
      "@fluixi/reactive/store",
      "@fluixi/jsx",
      "@fluixi/dom",
      "@fluixi/dom/directives",
      "@fluixi/core",
      "@fluixi/core/client",
      "@fluixi/utils",
      "@fluixi/*",
      "vite",
      "inquirer",
      "fs-extra",
      "process",
      "path",
      "fs",
      "child_process",
      "events",
      "url",
      "react-dom",
      "react-dom/*",
      "@fluixi/*",
      "stream",
      "http",
      "esbuild",
      "@babel/core",
      "@types/babel__core",
      "vinxi",
      "vinxi/*",
      "@vinxi/*",
      "execa"
    ],
    "copyFiles": [
      {
        "from": "types/fluixi.d.ts",
        "to": "./dist/fluixi.d.ts"
      }
    ],
    "clean": true,
    "banner": {
      "js": "/*! {name} v{version} | (c) {year} {author} and Fluixi contributors | {license} */",
      "include": [
        "src/index.ts",
        "src/lib/client/index.ts",
        "src/lib/i18n/index.ts",
        "src/lib/jsx-runtime/index.ts",
        "src/lib/jsx-runtime/jsx-dev-runtime.ts",
        "src/lib/router/index.ts",
        "src/lib/server/index.ts",
        "src/lib/storage/index.ts",
        "src/routes.ts",
        "src/utils.ts"
      ]
    },
    "define": {
      "process.env.NODE_ENV": "process.env.NODE_ENV"
    }
  }
}
