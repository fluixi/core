{
  "$schema": "./node_modules/@bambiste/mix-builder/dist/lib/builder/schema/build-config.schema.json",
  "builder": "esbuild",
  "esbuild": {
    "extensions": [
      ".ts"
    ],
    "target": "es2021",
    "platform": "browser",
    "minify": false,
    "noExternal": true,
    "outdir": "dist/cdn/dev",
    "rootDir": "src/cdn",
    "entries": {
      "src/cdn/core.ts": {
        "globalName": "Fluixi",
        "formats": [
          "iife"
        ]
      }
    },
    "define": {
      "__DEV__": "true",
      "process.env.NODE_ENV": "\"development\""
    },
    "banner": "/*! {name} v{version} | (c) {year} {author} and Fluixi contributors | {license} */"
  }
}
