{
  "$schema": "./node_modules/@bambiste/mix-builder/dist/lib/builder/schema/build-config.schema.json",
  "builder": "esbuild",
  "tsc": {
    "project": "tsconfig.lib.json"
  },
  "esbuild": {
    "extensions": [
      ".js",
      ".jsx",
      ".ts",
      ".tsx"
    ],
    "target": "es2021",
    "formats": [
      "es",
      "cjs"
    ],
    "entries": [
      "src/**/*.ts"
    ],
    "rootDir": "src",
    "externals": [
      "@babel/*",
      "babel",
      "fs",
      "path",
      "url",
      "module",
      "node:*"
    ],
    "clean": true,
    "cjsTypes": true,
    "banner": {
      "js": "/*! {name} v{version} | (c) {year} {author} and Fluixi contributors | {license} */",
      "include": [
        "src/analyze/static-graph.ts",
        "src/frontend/babel/index.ts",
        "src/index.ts",
        "src/integrations.ts",
        "src/lower/compile-template.ts",
        "src/resolve/builtins.ts",
        "src/transform/index.ts"
      ]
    },
    "define": {
      "process.env.NODE_ENV": "process.env.NODE_ENV"
    }
  }
}
