{
  "name": "@fluixi/compiler",
  "version": "1.0.0-alpha.76",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fluixi/core.git",
    "directory": "packages/compiler"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs",
        "default": "./dist/index.js"
      },
      "./babel": {
        "types": "./dist/frontend/babel/index.d.ts",
        "import": "./dist/frontend/babel/index.mjs",
        "require": "./dist/frontend/babel/index.cjs",
        "default": "./dist/frontend/babel/index.js"
      },
      "./integrations": {
        "types": "./dist/integrations.d.ts",
        "import": "./dist/integrations.mjs",
        "require": "./dist/integrations.cjs",
        "default": "./dist/integrations.js"
      }
    }
  },
  "description": "Fluixi JSX compiler — host-agnostic IR + pluggable codegen backends. Babel/SWC are front-end adapters.",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./babel": {
      "development": "./src/frontend/babel/index.ts",
      "types": "./dist/frontend/babel/index.d.ts",
      "import": "./dist/frontend/babel/index.mjs",
      "require": "./dist/frontend/babel/index.cjs",
      "default": "./dist/frontend/babel/index.js"
    },
    "./integrations": {
      "development": "./src/integrations.ts",
      "types": "./dist/integrations.d.ts",
      "import": "./dist/integrations.mjs",
      "require": "./dist/integrations.cjs",
      "default": "./dist/integrations.js"
    },
    "./builtins": {
      "development": "./src/resolve/builtins.ts",
      "types": "./dist/resolve/builtins.d.ts",
      "import": "./dist/resolve/builtins.mjs",
      "require": "./dist/resolve/builtins.cjs",
      "default": "./dist/resolve/builtins.js"
    },
    "./transform": {
      "development": "./src/transform/index.ts",
      "types": "./dist/transform/index.d.ts",
      "import": "./dist/transform/index.mjs",
      "require": "./dist/transform/index.cjs",
      "default": "./dist/transform/index.js"
    }
  },
  "scripts": {
    "build:typings": "tsc -p tsconfig.lib.json",
    "build": "pnpm run build:typings && cross-env NODE_ENV=production mix-builder",
    "dev": "tsc -w -p tsconfig.lib.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@babel/parser": "^7.28.5",
    "@fluixi/template-parser": "workspace:*",
    "magic-string": "^0.30.21"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/generator": "^7.29.1",
    "@babel/helper-plugin-utils": "^7.27.1",
    "@babel/plugin-transform-modules-commonjs": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@bambiste/mix-builder": "^0.1.0",
    "@fluixi/dom": "workspace:*",
    "@fluixi/reactive": "workspace:*",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@types/babel__core": "^7.20.5",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__helper-plugin-utils": "^7.10.3",
    "cross-env": "^7.0.3",
    "inquirer": "^14.0.2",
    "jsdom": "^25.0.0",
    "vitest": "^1.6.1"
  },
  "peerDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/generator": "^7.29.1",
    "@babel/helper-plugin-utils": "^7.27.1",
    "@babel/preset-typescript": "^7.28.5"
  },
  "peerDependenciesMeta": {
    "@babel/core": {
      "optional": true
    },
    "@babel/generator": {
      "optional": true
    },
    "@babel/helper-plugin-utils": {
      "optional": true
    },
    "@babel/preset-typescript": {
      "optional": true
    }
  }
}
