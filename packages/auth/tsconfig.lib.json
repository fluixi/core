{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["dom", "DOM.Iterable", "es2021", "es2015"]
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../utils/tsconfig.lib.json"
    },
    {
      "path": "../start/tsconfig.lib.json"
    },
    {
      "path": "../server/tsconfig.lib.json"
    },
    {
      "path": "../reactive/tsconfig.lib.json"
    },
    {
      "path": "../dom/tsconfig.lib.json"
    },
    {
      "path": "../core/tsconfig.lib.json"
    }
  ],
  "exclude": ["vite.config.ts", "src/**/*.spec.ts", "src/**/*.test.ts", "dist"]
}
