{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["dom", "DOM.Iterable", "es2021", "es2015"]
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../dom/tsconfig.lib.json"
    },
    {
      "path": "../testing/tsconfig.lib.json"
    },
    {
      "path": "../auth/tsconfig.lib.json"
    },
    {
      "path": "../server/tsconfig.lib.json"
    },
    {
      "path": "../start/tsconfig.lib.json"
    },
    {
      "path": "../session/tsconfig.lib.json"
    },
    {
      "path": "../reactive/tsconfig.lib.json"
    },
    {
      "path": "../core/tsconfig.lib.json"
    }
  ],
  "exclude": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "dist"
  ]
}
