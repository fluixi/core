{
  "name": "@fluixi/oauth2",
  "version": "1.0.0-alpha.114",
  "license": "MIT",
  "author": "Ibrahima Touré",
  "description": "OAuth2 / OIDC for Fluixi apps: an AuthClient that drives the flow, and an AuthService built on @fluixi/session. Browser PKCE or a server-held session, chosen by config.",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/fluixi/core.git",
    "directory": "packages/oauth2"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs",
        "default": "./dist/index.js"
      },
      "./server": {
        "types": "./dist/server.d.ts",
        "import": "./dist/server.mjs",
        "require": "./dist/server.cjs",
        "default": "./dist/server.js"
      },
      "./verify": {
        "types": "./dist/verify.d.ts",
        "import": "./dist/verify.mjs",
        "require": "./dist/verify.cjs",
        "default": "./dist/verify.js"
      },
      "./service": {
        "types": "./dist/service-client.d.ts",
        "import": "./dist/service-client.mjs",
        "require": "./dist/service-client.cjs",
        "default": "./dist/service-client.js"
      },
      "./callback": {
        "types": "./dist/callback.d.ts",
        "import": "./dist/callback.mjs",
        "require": "./dist/callback.cjs",
        "default": "./dist/callback.js"
      },
      "./presets": {
        "types": "./dist/presets.d.ts",
        "import": "./dist/presets.mjs",
        "require": "./dist/presets.cjs",
        "default": "./dist/presets.js"
      },
      "./roles": {
        "types": "./dist/roles.d.ts",
        "import": "./dist/roles.mjs",
        "require": "./dist/roles.cjs",
        "default": "./dist/roles.js"
      },
      "./env": {
        "types": "./dist/env-config.d.ts",
        "import": "./dist/env-config.mjs",
        "require": "./dist/env-config.cjs",
        "default": "./dist/env-config.js"
      }
    }
  },
  "scripts": {
    "build:typings": "tsc -p tsconfig.lib.json",
    "build": "cross-env NODE_ENV=production mix-builder",
    "dev": "tsc -w -p tsconfig.lib.json",
    "test": "vitest run",
    "conformance": "node conformance/run.mjs"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.cjs",
      "default": "./dist/server.js"
    },
    "./verify": {
      "development": "./src/verify.ts",
      "types": "./dist/verify.d.ts",
      "import": "./dist/verify.mjs",
      "require": "./dist/verify.cjs",
      "default": "./dist/verify.js"
    },
    "./service": {
      "development": "./src/service-client.ts",
      "types": "./dist/service-client.d.ts",
      "import": "./dist/service-client.mjs",
      "require": "./dist/service-client.cjs",
      "default": "./dist/service-client.js"
    },
    "./callback": {
      "development": "./src/callback.ts",
      "types": "./dist/callback.d.ts",
      "import": "./dist/callback.mjs",
      "require": "./dist/callback.cjs",
      "default": "./dist/callback.js"
    },
    "./presets": {
      "development": "./src/presets.ts",
      "types": "./dist/presets.d.ts",
      "import": "./dist/presets.mjs",
      "require": "./dist/presets.cjs",
      "default": "./dist/presets.js"
    },
    "./roles": {
      "development": "./src/roles.ts",
      "types": "./dist/roles.d.ts",
      "import": "./dist/roles.mjs",
      "require": "./dist/roles.cjs",
      "default": "./dist/roles.js"
    },
    "./env": {
      "development": "./src/env-config.ts",
      "types": "./dist/env-config.d.ts",
      "import": "./dist/env-config.mjs",
      "require": "./dist/env-config.cjs",
      "default": "./dist/env-config.js"
    }
  },
  "dependencies": {
    "@fluixi/auth": "workspace:^",
    "@fluixi/session": "workspace:^"
  },
  "peerDependencies": {
    "@fluixi/core": "workspace:^",
    "@fluixi/di": "workspace:^",
    "@fluixi/dom": "workspace:^",
    "@fluixi/reactive": "workspace:^",
    "@fluixi/server": "workspace:^",
    "@fluixi/start": "workspace:^",
    "@fluixi/storage": "workspace:^",
    "jose": ">=5"
  },
  "devDependencies": {
    "@bambiste/mix-builder": "^0.5.0",
    "@fluixi/auth": "workspace:*",
    "@fluixi/core": "workspace:*",
    "@fluixi/di": "workspace:*",
    "@fluixi/dom": "workspace:*",
    "@fluixi/reactive": "workspace:*",
    "@fluixi/server": "workspace:*",
    "@fluixi/session": "workspace:*",
    "@fluixi/start": "workspace:*",
    "@fluixi/storage": "workspace:*",
    "@fluixi/testing": "workspace:*",
    "cross-env": "^7.0.3",
    "jose": "^5.9.6"
  },
  "peerDependenciesMeta": {
    "@fluixi/start": {
      "optional": true
    },
    "@fluixi/server": {
      "optional": true
    },
    "jose": {
      "optional": true
    },
    "@fluixi/core": {
      "optional": true
    }
  }
}
