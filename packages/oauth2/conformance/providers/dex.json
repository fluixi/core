{
  "issuer": "http://localhost:5556/dex",
  "client": {
    "clientId": "acme-admin",
    "redirectUri": "http://localhost:3000/callback",
    "scopes": [
      "openid",
      "profile",
      "email",
      "offline_access"
    ]
  },
  "user": {
    "username": "admin@acme.test",
    "password": "admin123",
