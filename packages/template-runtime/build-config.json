{
  "$schema": "./node_modules/@bambiste/mix-builder/dist/lib/builder/schema/build-config.schema.json",
  "builder": "esbuild",
  "esbuild": {
    "extensions": [
      ".js",
      ".ts"
    ],
    "target": "es2021",
    "formats": [
      "es",
      "cjs"
    ],
    "entries": [
      "src/index.ts",
      "src/classify.ts"
    ],
    "rootDir": "src",
    "externals": [],
    "minify": false,
    "clean": false
  }
}
