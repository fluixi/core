{
  "name": "@fluixi/template-runtime",
  "version": "0.1.0-alpha.0",
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs",
        "default": "./dist/index.js"
      }
    }
  },
  "description": "compiles html`` templates in the browser and evaluates them against the @fluixi/dom runtime, for pages with no build step",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/cdn/fluixi.global.js",
  "jsdelivr": "./dist/cdn/fluixi.global.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build:typings": "tsc -p tsconfig.lib.json",
    "build": "pnpm run build:typings && cross-env NODE_ENV=production mix-builder && pnpm run build:cdn",
    "build:cdn": "cross-env NODE_ENV=production mix-builder --buildConfigFile=build-config.cdn.json",
    "dev": "tsc -w -p tsconfig.lib.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fluixi/compiler": "workspace:*",
    "@fluixi/dom": "workspace:*",
    "@fluixi/reactive": "workspace:*",
    "@fluixi/template-parser": "workspace:*"
  },
  "devDependencies": {
    "@bambiste/mix-builder": "^0.1.0",
    "cross-env": "^7.0.3",
    "jsdom": "^25.0.0",
    "vitest": "^1.6.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fluixi/core.git",
    "directory": "packages/template-runtime"
  }
}
