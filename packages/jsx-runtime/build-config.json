{
  "$schema": "./node_modules/@fluixi/mix-builder/dist/lib/builder/schema/build-config.schema.json",
  "builder": "esbuild",
  "esbuild": {
    "extensions": [
      ".js",
      ".jsx",
      ".ts",
      ".tsx"
    ],
    "target": "es2021",
    "formats": [
      "es",
      "cjs"
    ],
    "entries": [
      "src/**/*.ts"
    ],
    "rootDir": "src",
    "externals": [
      "@fluixi/reactive",
      "@fluixi/reactive/signal",
      "@fluixi/reactive/store",
      "@fluixi/jsx-runtime",
      "@fluixi/dom",
      "@fluixi/dom/directives",
      "@fluixi/kettlejs",
      "@fluixi/kettlejs/router",
      "@fluixi/kettlejs/client",
      "@fluixi/kettlejs/plugins",
      "@fluixi/utils",
      "@fluixi/*",
      "lit",
      "lit/*",
      "@lit-labs/*",
      "fs",
      "@babel/*",
      "@fluixi/babel-plugin-jsx",
      "react"
    ],
    "minify": false,
    "clean": true
  }
}
