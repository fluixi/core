{
  "name": "@fluixi/jsx-runtime",
  "version": "0.4.0-next.12",
  "private": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/",
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "development": "./src/lib/jsx-runtime.ts",
      "types": "./dist/lib/jsx-runtime.d.ts",
      "import": "./dist/lib/jsx-runtime.mjs",
      "require": "./dist/lib/jsx-runtime.cjs",
      "default": "./dist/lib/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "development": "./src/lib/jsx-dev-runtime.ts",
      "types": "./dist/lib/jsx-dev-runtime.d.ts",
      "import": "./dist/lib/jsx-dev-runtime.mjs",
      "require": "./dist/lib/jsx-dev-runtime.cjs",
      "default": "./dist/lib/jsx-dev-runtime.js"
    }
  },
  "scripts": {
    "build:typings": "tsc -p tsconfig.lib.json",
    "build": "pnpm run build:typings && cross-env NODE_ENV=production mix-builder && pnpm run copy:types",
    "copy:types": "cp ./src/lib/jsx.d.ts dist/lib",
    "dev": "tsc -w -p tsconfig.lib.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fluixi/dom": "workspace:*",
    "@fluixi/reactive": "workspace:*",
    "lit": "^3.3.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@bambiste/mix-builder": "*",
    "@types/babel__core": "^7.20.5",
    "@types/react": "^19.2.7",
    "inquirer": "^13.1.0",
    "jsdom": "^25.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "vitest": "^1.6.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fluixi/core.git",
    "directory": "packages/jsx-runtime"
  }
}
