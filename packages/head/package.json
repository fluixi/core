{
  "name": "@fluixi/head",
  "version": "1.0.0-alpha.114",
  "license": "MIT",
  "author": "Ibrahima Touré",
  "description": "Built-in reactive, SSR-first SEO & document-head management for Fluixi — title, meta, Open Graph, Twitter, JSON-LD, canonical, hreflang, sitemap & robots.",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "cross-env NODE_ENV=production mix-builder",
    "test": "vitest run",
    "build:typings": "tsc -p tsconfig.lib.json",
    "dev": "tsc -w -p tsconfig.lib.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs",
        "default": "./dist/index.js"
      }
    }
  },
  "peerDependencies": {
    "@fluixi/reactive": "workspace:^"
  },
  "devDependencies": {
    "@fluixi/reactive": "workspace:*",
    "@bambiste/mix-builder": "^0.5.0",
    "cross-env": "^7.0.3"
  }
}
