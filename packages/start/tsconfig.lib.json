{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "lib": ["es2022", "dom"]
  },
  "include": ["src/**/*.ts"],
  "references": [
    { "path": "../reactive/tsconfig.lib.json" },
    {
      "path": "../vite-plugin/tsconfig.lib.json"
    },
    {
      "path": "../compiler/tsconfig.lib.json"
    },
    {
      "path": "../head/tsconfig.lib.json"
    },
    {
      "path": "../dom/tsconfig.lib.json"
    },
    {
      "path": "../server/tsconfig.lib.json"
    },
    {
      "path": "../core/tsconfig.lib.json"
    }
  ],
  "exclude": ["src/**/*.test.ts", "src/**/*.spec.ts", "dist"]
}
