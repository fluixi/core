{
  "name": "@fluixi/start",
  "version": "0.1.0-alpha.51",
  "license": "MIT",
  "description": "The Fluixi meta-framework — dev server, build, and production SSR server over @fluixi/server + Vite.",
  "repository": {
    "type": "git",
    "url": "https://github.com/fluixi/core.git",
    "directory": "packages/start"
  },
  "private": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "exports": {
      "./package.json": "./package.json",
      "./ui": {
        "types": "./dist/ui.d.ts",
        "import": "./dist/ui.js",
        "default": "./dist/ui.js"
      },
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./config": {
        "types": "./dist/config.d.ts",
        "import": "./dist/config.js",
        "default": "./dist/config.js"
      },
      "./router": {
        "types": "./dist/router.d.ts",
        "import": "./dist/router.js",
        "default": "./dist/router.js"
      },
      "./head": {
        "types": "./dist/head.d.ts",
        "import": "./dist/head.js",
        "default": "./dist/head.js"
      },
      "./server-fn": {
        "types": "./dist/server-fn.d.ts",
        "import": "./dist/server-fn.js",
        "default": "./dist/server-fn.js"
      },
      "./server-fn-setup": {
        "types": "./dist/server-fn-setup.d.ts",
        "import": "./dist/server-fn-setup.js",
        "default": "./dist/server-fn-setup.js"
      },
      "./di": {
        "types": "./dist/di.d.ts",
        "import": "./dist/di.js",
        "default": "./dist/di.js"
      },
      "./api": {
        "types": "./dist/api.d.ts",
        "import": "./dist/api.js",
        "default": "./dist/api.js"
      }
    }
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "test": "vitest run"
  },
  "exports": {
    "./package.json": "./package.json",
    "./ui": {
      "development": "./src/ui.ts",
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js",
      "default": "./dist/ui.js"
    },
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./config": {
      "development": "./src/config.ts",
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./router": {
      "development": "./src/router.ts",
      "types": "./dist/router.d.ts",
      "import": "./dist/router.js",
      "default": "./dist/router.js"
    },
    "./head": {
      "development": "./src/head.ts",
      "types": "./dist/head.d.ts",
      "import": "./dist/head.js",
      "default": "./dist/head.js"
    },
    "./server-fn": {
      "development": "./src/server-fn.ts",
      "types": "./dist/server-fn.d.ts",
      "import": "./dist/server-fn.js",
      "default": "./dist/server-fn.js"
    },
    "./server-fn-setup": {
      "development": "./src/server-fn-setup.ts",
      "types": "./dist/server-fn-setup.d.ts",
      "import": "./dist/server-fn-setup.js",
      "default": "./dist/server-fn-setup.js"
    },
    "./di": {
      "development": "./src/di.ts",
      "types": "./dist/di.d.ts",
      "import": "./dist/di.js",
      "default": "./dist/di.js"
    },
    "./api": {
      "development": "./src/api.ts",
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js",
      "default": "./dist/api.js"
    }
  },
  "dependencies": {
    "@fluixi/core": "workspace:*",
    "@fluixi/server": "workspace:*",
    "@fluixi/dom": "workspace:*",
    "@fluixi/head": "workspace:*",
    "esbuild": "^0.27.1",
    "@fluixi/compiler": "workspace:*"
  },
  "peerDependencies": {
    "vite": "^5.0.0"
  }
}
