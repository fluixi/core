{
  "name": "@fluixi/start",
  "version": "0.1.0-next.6",
  "description": "The Fluixi meta-framework — dev server, build, and production SSR server over @fluixi/server + Vite.",
  "repository": {
    "type": "git",
    "url": "https://github.com/fluixi/core.git",
    "directory": "packages/start"
  },
  "private": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/",
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "test": "vitest run"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./config": {
      "development": "./src/config.ts",
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./router": {
      "development": "./src/router.ts",
      "types": "./dist/router.d.ts",
      "import": "./dist/router.js",
      "default": "./dist/router.js"
    },
    "./server-fn": {
      "development": "./src/server-fn.ts",
      "types": "./dist/server-fn.d.ts",
      "import": "./dist/server-fn.js",
      "default": "./dist/server-fn.js"
    },
    "./server-fn-setup": {
      "development": "./src/server-fn-setup.ts",
      "types": "./dist/server-fn-setup.d.ts",
      "import": "./dist/server-fn-setup.js",
      "default": "./dist/server-fn-setup.js"
    }
  },
  "dependencies": {
    "@fluixi/core": "workspace:*",
    "@fluixi/server": "workspace:*",
    "esbuild": "^0.27.1",
    "@fluixi/compiler": "workspace:*"
  },
  "peerDependencies": {
    "vite": "^5.0.0"
  }
}
