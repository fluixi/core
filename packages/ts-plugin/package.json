{
  "name": "@fluixi/ts-plugin",
  "version": "0.1.0-alpha.20",
  "license": "MIT",
  "author": "Ibrahima Touré",
  "private": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "description": "gives html`` templates the editor support JSX already gets; a component used only as a tag is no longer reported as unused",
  "type": "commonjs",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --external:typescript --outfile=dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@fluixi/template-parser": "workspace:*",
    "@fluixi/compiler": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.9.0",
    "vitest": "^1.6.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fluixi/core.git",
    "directory": "packages/ts-plugin"
  }
}
