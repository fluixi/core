{
  "name": "@fluixi/ts-plugin",
  "version": "1.0.0-alpha.112",
  "license": "MIT",
  "author": "Ibrahima Touré",
  "private": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "exports": {
      "./package.json": "./package.json",
      ".": "./dist/index.js",
      "./rules": {
        "types": "./dist/rules.d.ts",
        "default": "./dist/rules.js"
      }
    }
  },
  "description": "gives html`` templates the editor support JSX already gets; a component used only as a tag is no longer reported as unused",
  "type": "commonjs",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "exports": {
    "./package.json": "./package.json",
    ".": "./dist/index.js",
    "./rules": {
      "types": "./dist/rules.d.ts",
      "development": "./src/rules.ts",
      "default": "./dist/rules.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json --emitDeclarationOnly && esbuild src/index.ts src/rules.ts --bundle --platform=node --format=cjs --external:typescript --outdir=dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@fluixi/template-parser": "workspace:^",
    "@fluixi/compiler": "workspace:^"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fluixi/core.git",
    "directory": "packages/ts-plugin"
  }
}
