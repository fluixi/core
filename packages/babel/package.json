{
  "name": "@fluixi/babel-plugin-jsx",
  "version": "1.0.0-alpha.54",
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build:typings": "tsc -p tsconfig.lib.json",
    "build": "pnpm run build:typings && cross-env NODE_ENV=production mix-builder",
    "dev": "tsc -w -p tsconfig.lib.json"
  },
  "dependencies": {
    "@fluixi/compiler": "workspace:*",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@bambiste/mix-builder": "*",
    "inquirer": "^14.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fluixi/core.git",
    "directory": "packages/babel"
  }
}
