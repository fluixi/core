{
  "$schema": "./node_modules/@bambiste/mix-builder/dist/lib/builder/schema/build-config.schema.json",
  "builder": "esbuild",
  "tsc": {
    "project": "tsconfig.lib.json"
  },
  "esbuild": {
    "extensions": [
      ".js",
      ".jsx",
      ".ts",
      ".tsx"
    ],
    "target": "es2021",
    "formats": [
      "es",
      "cjs"
    ],
    "entries": [
      "src/**/*.ts"
    ],
    "rootDir": "src",
    "externals": [
      "reactive/*",
      "@fluixi/*"
    ],
    "clean": true,
    "banner": {
      "js": "/*! {name} v{version} | (c) {year} {author} and Fluixi contributors | {license} */",
      "include": [
        "src/lib/index.ts",
        "src/lib/observable/index.ts",
        "src/lib/signal/cached-resource.ts",
        "src/lib/signal/graph/compat.ts",
        "src/lib/signal/graph/core.ts",
        "src/lib/signal/graph/index.ts",
        "src/lib/signal/graph/signal-next.ts",
        "src/lib/signal/index-legacy.ts",
        "src/lib/signal/index.ts",
        "src/lib/signal/utilities.ts",
        "src/lib/store/index.ts",
        "src/version.generated.ts"
      ]
    },
    "define": {
      "process.env.NODE_ENV": "process.env.NODE_ENV"
    },
    "development": true
  }
}
