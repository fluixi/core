{
  "name": "@fluixi/api",
  "version": "1.0.0-alpha.110",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "author": "Ibrahima Touré",
  "description": "Schema-first API routes for Fluixi: contracts validated before the handler runs, typed handlers, one error model, on top of @fluixi/start's API routes.",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./client": {
      "development": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "import": "./dist/client.mjs",
      "require": "./dist/client.cjs",
      "default": "./dist/client.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "cross-env NODE_ENV=production mix-builder",
    "test": "vitest run",
    "build:typings": "tsc -p tsconfig.lib.json",
    "dev": "tsc -w -p tsconfig.lib.json"
  },
  "devDependencies": {
    "@bambiste/mix-builder": "^0.4.3",
    "@electric-sql/pglite": "^0.5.8",
    "@fluixi/start": "workspace:*",
    "cross-env": "^7.0.3",
    "valibot": "^1.5.0",
    "zod": "^4.6.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fluixi/core.git",
    "directory": "packages/api"
  },
  "dependencies": {
    "rate-limiter-flexible": "^11.2.1"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs",
        "default": "./dist/index.js"
      },
      "./client": {
        "types": "./dist/client.d.ts",
        "import": "./dist/client.mjs",
        "require": "./dist/client.cjs",
        "default": "./dist/client.js"
      }
    }
  }
}
