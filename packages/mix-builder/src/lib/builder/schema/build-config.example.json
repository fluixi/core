{
  "$schema": "./build-config.schema.json",
  "rollup": {
    "extensions": [".ts", ".js", ".mjs"],
    "externals": [
      "lit",
      "@awc/helpers",
      "lit/directives/unsafe-html.js",
      "@lit/reactive-element",
      "lit/decorators.js",
      "@awc/adf-base"
    ],
    "formats": ["es"],
    "entries": {
      "src/index.ts": {
        "formats": ["es"],
        "name": "AdfCard",
        "buildType": "bundled",
        "externals": [
          "lit",
          "@awc/helpers",
          "lit/directives/unsafe-html.js",
          "@lit/reactive-element",
          "@awc/adf-base"
        ]
      },
      "src/adf-card.ts": {
        "formats": ["es"],
        "buildType": "bundled",
        "externals": [
          "lit",
          "@awc/helpers",
          "lit/directives/unsafe-html.js",
          "@lit/reactive-element",
          "@awc/adf-base"
        ],
        "name": "AdfCard"
      },
      "src/AdfCard.ts": {
        "formats": ["es"],
        "buildType": "bundled",
        "externals": [
          "lit",
          "@awc/helpers",
          "lit/directives/unsafe-html.js",
          "@lit/reactive-element",
          "@awc/adf-base"
        ],
        "name": "AdfCard"
      }
    }
  },
  "esbuild": {
    "target": "es2021",
    "formats": ["esm", "cjs"],
    "entries": ["src/index.ts", "src/adf-card.ts", "src/AdfCard.ts"]
  }
}
