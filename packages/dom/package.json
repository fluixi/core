{
  "name": "@fluixi/dom",
  "version": "0.3.0",
  "private": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/",
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./element": {
      "development": "./src/lib/element/index.ts",
      "types": "./dist/lib/element/index.d.ts",
      "import": "./dist/lib/element/index.mjs",
      "require": "./dist/lib/element/index.cjs",
      "default": "./dist/lib/element/index.js"
    },
    "./dom": {
      "development": "./src/lib/dom/dom.ts",
      "types": "./dist/lib/dom/dom.d.ts",
      "import": "./dist/lib/dom/dom.mjs",
      "require": "./dist/lib/dom/dom.cjs",
      "default": "./dist/lib/dom/dom.js"
    },
    "./server": {
      "development": "./src/lib/dom/server-renderer.ts",
      "types": "./dist/lib/dom/server-renderer.d.ts",
      "import": "./dist/lib/dom/server-renderer.mjs",
      "require": "./dist/lib/dom/server-renderer.cjs",
      "default": "./dist/lib/dom/server-renderer.js"
    },
    "./runtime": {
      "development": "./src/lib/dom/runtime.ts",
      "types": "./dist/lib/dom/runtime.d.ts",
      "import": "./dist/lib/dom/runtime.mjs",
      "require": "./dist/lib/dom/runtime.cjs",
      "default": "./dist/lib/dom/runtime.js"
    },
    "./integration": {
      "development": "./src/lib/dom/integration.ts",
      "types": "./dist/lib/dom/integration.d.ts",
      "import": "./dist/lib/dom/integration.mjs",
      "require": "./dist/lib/dom/integration.cjs",
      "default": "./dist/lib/dom/integration.js"
    },
    "./control-flow": {
      "development": "./src/lib/dom/control-flow.ts",
      "types": "./dist/lib/dom/control-flow.d.ts",
      "import": "./dist/lib/dom/control-flow.mjs",
      "require": "./dist/lib/dom/control-flow.cjs",
      "default": "./dist/lib/dom/control-flow.js"
    },
    "./utils": {
      "development": "./src/lib/dom/utils.ts",
      "types": "./dist/lib/dom/utils.d.ts",
      "import": "./dist/lib/dom/utils.mjs",
      "require": "./dist/lib/dom/utils.cjs",
      "default": "./dist/lib/dom/utils.js"
    }
  },
  "scripts": {
    "build:typings": "tsc -p tsconfig.lib.json",
    "build": "pnpm run build:typings && cross-env NODE_ENV=production mix-builder",
    "dev": "tsc -w -p tsconfig.lib.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fluixi/reactive": "workspace:*",
    "lit": "^3.3.1",
    "stream": "^0.0.3",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@bambiste/mix-builder": "*",
    "inquirer": "^13.1.0",
    "vitest": "^1.6.1",
    "jsdom": "^25.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fluixi/core.git",
    "directory": "packages/dom"
  }
}
