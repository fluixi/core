  "scripts": {
    "build:typings": "tsc -p tsconfig.lib.json",
    "build": "node ../../scripts/gen-version.mjs && cross-env NODE_ENV=production mix-builder && pnpm run build:cdn",
    "build:cdn": "cross-env NODE_ENV=production mix-builder --buildConfigFile=build-config.cdn.json && cross-env NODE_ENV=development mix-builder --buildConfigFile=build-config.cdn.dev.json",
    "dev": "tsc -w -p tsconfig.lib.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "stream": "^0.0.3"
  },
  "devDependencies": {
    "@bambiste/mix-builder": "^0.5.0",
    "@fluixi/reactive": "workspace:*",
    "esbuild": "^0.27.1",
    "inquirer": "^13.1.0",
    "jsdom": "^25.0.0",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fluixi/core.git",
    "directory": "packages/dom"
