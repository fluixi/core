{
  "$schema": "./node_modules/@awc/mix-builder/dist/lib/builder/schema/build-config.schema.json",
  "builder": "esbuild",
  "esbuild": {
    "extensions": [".js", ".jsx", ".ts", ".tsx"],
    "target": "es2021",
    "formats": ["es", "cjs"],
    "entries": ["src/**/*.ts"],
    "rootDir": "src",
    "externals": ["@awc/*", "lit", "lit/*", "@babel/*",
    "@awc/reactive",
      "@awc/reactive/signal",
      "@awc/reactive/store",
      "@awc/jsx-runtime",
      "@awc/dom",
      "@awc/dom/directives",
      "@awc/kettlejs",
      "@awc/kettlejs/router",
      "@awc/kettlejs/client",
      "@awc/kettlejs/plugins",
      "@awc/utils"],
    "minify": false
  }
}
