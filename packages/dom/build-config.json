{
  "$schema": "./node_modules/@bambiste/mix-builder/dist/lib/builder/schema/build-config.schema.json",
  "builder": "esbuild",
  "tsc": {
    "project": "tsconfig.lib.json"
  },
  "esbuild": {
    "extensions": [
      ".js",
      ".jsx",
      ".ts",
      ".tsx"
    ],
    "target": "es2021",
    "formats": [
      "es",
      "cjs"
    ],
    "entries": [
      "src/**/*.ts"
    ],
    "rootDir": "src",
    "externals": [
      "@fluixi/*",
      "@babel/*",
      "@fluixi/reactive",
      "@fluixi/reactive/signal",
      "@fluixi/reactive/store",
      "@fluixi/jsx",
      "@fluixi/dom",
      "@fluixi/dom/directives",
      "@fluixi/core",
      "@fluixi/core/client",
      "@fluixi/utils"
    ],
    "clean": true,
    "banner": {
      "js": "/*! {name} v{version} | (c) {year} {author} and Fluixi contributors | {license} */",
      "include": [
        "src/index.ts",
        "src/lib/dom/integration.ts",
        "src/lib/dom/runtime.ts",
        "src/lib/dom/index.ts",
        "src/lib/dom/server-renderer.ts",
        "src/lib/dom/utils.ts",
        "src/lib/element/attributes.ts",
        "src/lib/element/index.ts",
        "src/lib/flow/index.ts"
      ]
    },
    "define": {
      "process.env.NODE_ENV": "process.env.NODE_ENV"
    },
    "development": true
  }
}
