{
  "$schema": "./node_modules/@bambiste/mix-builder/dist/lib/builder/schema/build-config.schema.json",
  "builder": "esbuild",
  "esbuild": {
    "extensions": [
      ".ts"
    ],
    "target": "es2021",
    "platform": "browser",
    "minify": true,
    "noExternal": true,
    "outdir": "dist/cdn",
    "rootDir": "src/cdn",
    "entries": {
      "src/cdn/dom.ts": {
        "globalName": "FluixiDOM",
        "formats": [
          "iife"
        ]
      },
      "src/cdn/dom-client.ts": {
        "globalName": "FluixiDOM",
        "formats": [
          "iife"
        ]
      }
    }
  }
}
