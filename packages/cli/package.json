{
  "name": "@fluixi/cli",
  "version": "1.0.0-alpha.113",
  "license": "MIT",
  "author": "Ibrahima Touré",
  "description": "The `fluixi` command-line tool — dev/build/start (via @fluixi/start) and, later, scaffolding + generators.",
  "repository": {
    "type": "git",
    "url": "https://github.com/fluixi/core.git",
    "directory": "packages/cli"
  },
  "private": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs",
        "default": "./dist/index.js"
      },
      "./scaffold": {
        "types": "./dist/scaffold/index.d.ts",
        "import": "./dist/scaffold/index.mjs",
        "require": "./dist/scaffold/index.cjs",
        "default": "./dist/scaffold/index.js"
      }
    }
  },
  "type": "module",
  "bin": {
    "fluixi": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "cross-env NODE_ENV=production mix-builder",
    "test": "vitest run",
    "build:typings": "tsc -p tsconfig.lib.json",
    "dev": "tsc -w -p tsconfig.lib.json"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./scaffold": {
      "development": "./src/scaffold/index.ts",
      "types": "./dist/scaffold/index.d.ts",
      "import": "./dist/scaffold/index.mjs",
      "require": "./dist/scaffold/index.cjs",
      "default": "./dist/scaffold/index.js"
    }
  },
  "dependencies": {
    "@fluixi/start": "workspace:^",
    "@fluixi/ts-plugin": "workspace:^",
    "typescript-api": "npm:typescript@^6.0.3"
  },
  "devDependencies": {
    "@bambiste/mix-builder": "^0.5.0",
    "cross-env": "^7.0.3",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
