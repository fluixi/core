{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/vitest",
    "types": ["vitest/globals", "vitest/importMeta", "node", "vitest"],
    "lib": ["dom", "DOM.Iterable", "es2021"],
    "forceConsistentCasingInFileNames": true
