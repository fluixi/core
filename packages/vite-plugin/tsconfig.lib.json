{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "lib": ["dom", "DOM.Iterable", "es2021", "es2015"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../devtools/tsconfig.lib.json"
    },
    {
      "path": "../compiler/tsconfig.lib.json"
    }
  ],
  "exclude": [
    "vite.config.ts",
    "vitest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ]
}
