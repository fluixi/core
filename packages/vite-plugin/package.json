{
  "name": "@fluixi/vite-plugin",
  "version": "1.0.0-alpha.40",
  "private": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/",
    "access": "public"
  },
  "description": "Vite plugin for Fluixi — compiles JSX via @fluixi/compiler (jsx or imperative backend).",
  "type": "module",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build:typings": "tsc -p tsconfig.lib.json",
    "build": "pnpm run build:typings && cross-env NODE_ENV=production mix-builder",
    "dev": "tsc -w -p tsconfig.lib.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fluixi/compiler": "workspace:*",
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "vite": ">=4"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bambiste/mix-builder": "*",
    "cross-env": "^7.0.3",
    "inquirer": "^14.0.2",
    "vite": "^5.0.0",
    "vitest": "^1.6.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fluixi/core.git",
    "directory": "packages/vite-plugin"
  }
}
