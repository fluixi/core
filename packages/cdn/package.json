{
  "name": "@fluixi/cdn",
  "version": "1.0.0-alpha.114",
  "license": "MIT",
  "author": "Ibrahima Touré",
  "private": false,
  "description": "pre-generated import maps for loading the framework from a CDN: the minimum for writing components by hand, the addition that compiles html`` in the page, and everything",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./min.json": "./dist/min.json",
    "./templates.json": "./dist/templates.json",
    "./full.json": "./dist/full.json",
    "./min.js": "./dist/min.js",
    "./templates.js": "./dist/templates.js",
    "./full.js": "./dist/full.js",
    "./min.development.json": "./dist/min.development.json",
    "./min.development.js": "./dist/min.development.js",
    "./templates.development.json": "./dist/templates.development.json",
    "./templates.development.js": "./dist/templates.development.js",
    "./full.development.json": "./dist/full.development.json",
    "./full.development.js": "./dist/full.development.js"
  },
  "scripts": {
    "build": "mappel && node scripts/bundle.mjs"
  },
  "devDependencies": {
    "@fluixi/template-runtime": "workspace:*",
    "esbuild": "^0.27.1",
    "mappel": "^0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fluixi/core.git",
    "directory": "packages/cdn"
  },
  "nx": {
    "implicitDependencies": [
      "@fluixi/core",
      "@fluixi/dom",
      "@fluixi/utils",
      "@fluixi/reactive",
      "@fluixi/router",
      "@fluixi/head",
      "@fluixi/storage",
      "@fluixi/compiler",
      "@fluixi/template-parser",
      "@fluixi/template-runtime"
    ]
  }
}
