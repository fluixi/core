{
  "name": "@fluixi/element",
  "version": "0.0.0",
  "private": false,
  "description": "Web Component support for KettleJS - defineElement, KettleElement, KettleLitElement, KettleController",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/",
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "development": "./src/plugin.ts",
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./types": {
      "development": "./src/lib/types.ts",
      "types": "./dist/lib/types.ts.d.ts"
    },
    "./jsx": {
      "development": "./src/lib/create-component.ts",
      "types": "./dist/lib/create-component.d.ts",
      "import": "./dist/lib/create-component.mjs",
      "default": "./dist/lib/create-component.js"
    }
  },
  "scripts": {
    "build:typings": "tsc -p tsconfig.lib.json",
    "build": "pnpm run build:typings && cross-env NODE_ENV=production mix-builder"
  },
  "dependencies": {
    "@fluixi/dom": "workspace:*",
    "@fluixi/reactive": "workspace:*",
    "lit": "^3.3.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@bambiste/mix-builder": "*",
    "inquirer": "^13.2.5"
  }
}
