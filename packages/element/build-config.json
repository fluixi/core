{
  "$schema": "./node_modules/@awc/mix-builder/dist/lib/builder/schema/build-config.schema.json",
  "builder": "esbuild",
  "esbuild": {
    "extensions": [".js", ".jsx", ".ts", ".tsx"],
    "target": "es2022",
    "formats": ["es", "cjs"],
    "entries": ["src/**/*.ts"],
    "rootDir": "src",
    "externals": [
      "@awc/reactive",
      "@awc/reactive/signal",
      "@awc/reactive/store",
      "@awc/jsx-runtime",
      "@awc/dom",
      "@awc/dom/directives",
      "@awc/kettlejs",
      "@awc/kettlejs/router",
      "@awc/kettlejs/client",
      "@awc/kettlejs/plugins",
      "@awc/utils",
      "@awc/*",
      "vite",
      "inquirer",
      "fs-extra",
      "process",
      "path",
      "fs",
      "child_process",
      "events",
      "url",
      "react-dom",
      "react-dom/*",
      "@awc/*",
      "@lit-labs/*",
      "@lit/*",
      "lit",
      "lit/*",
      "stream",
      "http",
      "esbuild",
      "@babel/core",
      "@types/babel__core",
      "vinxi",
      "vinxi/*",
      "@vinxi/*",
      "execa"
    ]
  }
}
