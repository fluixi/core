{
  "$schema": "./node_modules/@fluixi/mix-builder/dist/lib/builder/schema/build-config.schema.json",
  "builder": "esbuild",
  "esbuild": {
    "extensions": [
      ".js",
      ".jsx",
      ".ts",
      ".tsx"
    ],
    "target": "es2022",
    "formats": [
      "es",
      "cjs"
    ],
    "entries": [
      "src/**/*.ts"
    ],
    "rootDir": "src",
    "externals": [
      "@fluixi/reactive",
      "@fluixi/reactive/signal",
      "@fluixi/reactive/store",
      "@fluixi/jsx-runtime",
      "@fluixi/dom",
      "@fluixi/dom/directives",
      "@fluixi/kettlejs",
      "@fluixi/kettlejs/router",
      "@fluixi/kettlejs/client",
      "@fluixi/kettlejs/plugins",
      "@fluixi/utils",
      "@fluixi/*",
      "vite",
      "inquirer",
      "fs-extra",
      "process",
      "path",
      "fs",
      "child_process",
      "events",
      "url",
      "react-dom",
      "react-dom/*",
      "@fluixi/*",
      "@lit-labs/*",
      "@lit/*",
      "lit",
      "lit/*",
      "stream",
      "http",
      "esbuild",
      "@babel/core",
      "@types/babel__core",
      "vinxi",
      "vinxi/*",
      "@vinxi/*",
      "execa"
    ],
    "clean": true
  }
}
