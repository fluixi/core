{
  "name": "@fluixi/web-components",
  "version": "1.0.0-alpha.114",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "author": "Ibrahima Touré",
  "description": "Publish a Fluixi component as a standard custom element, with fine-grained updates, native slots and no framework in the consumer.",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./hydrate": {
      "development": "./src/hydrate.ts",
      "types": "./dist/hydrate.d.ts",
      "import": "./dist/hydrate.mjs",
      "require": "./dist/hydrate.cjs",
      "default": "./dist/hydrate.js"
    },
    "./server": {
      "development": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.cjs",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "cross-env NODE_ENV=production mix-builder",
    "test": "vitest run",
    "test-browser": "vitest run -c vitest.browser.config.ts",
    "build:typings": "tsc -p tsconfig.lib.json",
    "dev": "tsc -w -p tsconfig.lib.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "development": {
          "import": "./dist/dev/index.mjs",
          "require": "./dist/dev/index.cjs",
          "default": "./dist/dev/index.mjs"
        },
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs",
        "default": "./dist/index.js"
      },
      "./hydrate": {
        "types": "./dist/hydrate.d.ts",
        "development": {
          "import": "./dist/dev/hydrate.mjs",
          "require": "./dist/dev/hydrate.cjs",
          "default": "./dist/dev/hydrate.mjs"
        },
        "import": "./dist/hydrate.mjs",
        "require": "./dist/hydrate.cjs",
        "default": "./dist/hydrate.js"
      },
      "./server": {
        "types": "./dist/server.d.ts",
        "development": {
          "import": "./dist/dev/server.mjs",
          "require": "./dist/dev/server.cjs",
          "default": "./dist/dev/server.mjs"
        },
        "import": "./dist/server.mjs",
        "require": "./dist/server.cjs",
        "default": "./dist/server.js"
      }
    }
  },
  "peerDependencies": {
    "@fluixi/dom": "workspace:^",
    "@fluixi/reactive": "workspace:^"
  },
  "devDependencies": {
    "@bambiste/mix-builder": "^0.5.0",
    "@fluixi/dom": "workspace:*",
    "@fluixi/reactive": "workspace:*",
    "@lit/context": "^1.1.6",
    "@vitest/browser": "3.2.7",
    "cross-env": "^7.0.3",
    "lit": "^3.3.3",
    "playwright": "^1.63.0",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fluixi/core.git",
    "directory": "packages/web-components"
  }
}
