{
  "name": "@fluixi/web-components",
  "version": "0.1.0-alpha.0",
  "license": "MIT",
  "author": "Ibrahima Touré",
  "private": true,
  "description": "Publish a Fluixi component as a standard custom element, with fine-grained updates, native slots and no framework in the consumer.",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "cross-env NODE_ENV=production mix-builder",
    "test": "vitest run",
    "build:typings": "tsc -p tsconfig.lib.json",
    "dev": "tsc -w -p tsconfig.lib.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs",
        "default": "./dist/index.js"
      }
    }
  },
  "peerDependencies": {
    "@fluixi/dom": "workspace:*",
    "@fluixi/reactive": "workspace:*"
  },
  "devDependencies": {
    "@fluixi/dom": "workspace:*",
    "@fluixi/reactive": "workspace:*",
    "@bambiste/mix-builder": "^0.4.0",
    "cross-env": "^7.0.3"
  }
}
