{
  "$schema": "./node_modules/@bambiste/mix-builder/dist/lib/builder/schema/build-config.schema.json",
  "builder": "esbuild",
  "tsc": {
    "project": "tsconfig.lib.json"
  },
  "esbuild": {
    "extensions": [
      ".js",
      ".jsx",
      ".ts",
      ".tsx"
    ],
    "target": "es2021",
    "formats": [
      "es",
      "cjs"
    ],
    "entries": [
      "src/**/*.ts"
    ],
    "rootDir": "src",
    "externals": [
      "@fluixi/reactive",
      "@fluixi/reactive/signal",
      "@fluixi/reactive/store",
      "@fluixi/jsx",
      "@fluixi/dom",
      "@fluixi/dom/directives",
      "@fluixi/core",
      "@fluixi/core/client",
      "@fluixi/core/plugins",
      "@fluixi/utils",
      "@fluixi/*",
      "@lit-labs/*",
      "fs",
      "@babel/*",
      "@fluixi/babel-plugin-jsx",
      "react"
    ],
    "clean": true,
    "banner": {
      "js": "/*! {name} v{version} | (c) {year} {author} and Fluixi contributors | {license} */",
      "include": [
        "src/index.ts",
        "src/lib/jsx-dev-runtime.ts",
        "src/lib/jsx-runtime.ts"
      ]
    }
  }
}
