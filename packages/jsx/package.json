{
  "name": "@fluixi/jsx",
  "version": "1.0.0-alpha.85",
  "description": "JSX runtime types and factory for Fluixi — fine-grained, no virtual DOM.",
  "license": "MIT",
  "author": "Ibrahima Touré",
  "private": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs",
        "default": "./dist/index.js"
      },
      "./jsx-runtime": {
        "types": "./dist/lib/jsx-runtime.d.ts",
        "import": "./dist/lib/jsx-runtime.mjs",
        "require": "./dist/lib/jsx-runtime.cjs",
        "default": "./dist/lib/jsx-runtime.js"
      },
      "./jsx-dev-runtime": {
        "types": "./dist/lib/jsx-dev-runtime.d.ts",
        "import": "./dist/lib/jsx-dev-runtime.mjs",
        "require": "./dist/lib/jsx-dev-runtime.cjs",
        "default": "./dist/lib/jsx-dev-runtime.js"
      }
    }
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "development": "./src/lib/jsx-runtime.ts",
      "types": "./dist/lib/jsx-runtime.d.ts",
      "import": "./dist/lib/jsx-runtime.mjs",
      "require": "./dist/lib/jsx-runtime.cjs",
      "default": "./dist/lib/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "development": "./src/lib/jsx-dev-runtime.ts",
      "types": "./dist/lib/jsx-dev-runtime.d.ts",
      "import": "./dist/lib/jsx-dev-runtime.mjs",
      "require": "./dist/lib/jsx-dev-runtime.cjs",
      "default": "./dist/lib/jsx-dev-runtime.js"
    }
  },
  "scripts": {
    "build:typings": "tsc -p tsconfig.lib.json",
    "build": "cross-env NODE_ENV=production mix-builder && pnpm run copy:types",
    "copy:types": "cp ./src/lib/jsx.d.ts dist/lib",
    "dev": "tsc -w -p tsconfig.lib.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@bambiste/mix-builder": "^0.4.0",
    "@fluixi/dom": "workspace:*",
    "@fluixi/reactive": "workspace:*",
    "inquirer": "^13.1.0",
    "jsdom": "^25.0.0",
    "vitest": "^1.6.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fluixi/core.git",
    "directory": "packages/jsx"
  },
  "peerDependencies": {
    "@fluixi/dom": "workspace:*",
    "@fluixi/reactive": "workspace:*"
  }
}
