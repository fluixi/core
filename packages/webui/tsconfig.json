{
  "compilerOptions": {
    "target": "esnext",
    "module": "ESNext",
    "importHelpers": true,
    "isolatedModules": true,
    "declaration": true,
    "composite": true,
    "noEmit": false,
    "lib": [
      "dom",
      "DOM.Iterable",
      "ESNext",
      "es2021",
      "es2015"
    ],
    "types": [
      "node",
    ],
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "checkJs": false,
    "strictNullChecks": true,
    "jsx": "preserve",
    "jsxImportSource": "@awc/jsx-runtime"
  },
  "include": [
    "src"
  ],
  // "exclude": [
  //   "../../../../adafri-webcomponents/packages/components/adf-icon/dist/src/AdfIcon.ts"
  // ]
}