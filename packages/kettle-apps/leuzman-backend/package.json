{
  "name": "leuzma-backend",
  "version": "0.0.1",
  "description": "Leuzman Store — Medusa v2 backend API",
  "license": "MIT",
  "scripts": {
    "dev": "cp .env.local .env && medusa develop",
    "build": "cp .env.prod .env && medusa build",
    "build:dev": "cp .env.dev .env && medusa build",
    "start": "medusa start",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "seed:admin": "medusa exec ./src/scripts/assign-superadmin.ts",
    "seed:categories": "medusa exec ./src/scripts/seed-categories.ts",
    "seed:products": "medusa exec ./src/scripts/seed-products.ts",
    "migrate": "medusa db:migrate",
    "migrate:dev": "medusa db:migrate",
    "db:setup": "medusa db:create && medusa db:migrate && pnpm seed",
    "copy_env": "cp .env.prod .env",
    "docker:up:server": "cp .env.dev .env && docker compose -f docker-compose.prod.yml --env-file .env up --build -d",
    "docker:up": "cp .env.prod .env && docker compose --env-file .env up --build -d",
    "docker:up:dev": "cp .env.dev .env && docker compose --env-file .env up --build -d",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v",
    "docker:logs": "docker compose logs -f medusa",
    "docker:down:server": "docker compose -f docker-compose.prod.yml down --remove-orphans",
    "docker:reset:server": "docker compose -f docker-compose.prod.yml down -v",
    "copy:loc": "cp ../../../pnpm-lock.yaml ./pnpm-lock.yaml"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.14.2",
    "@medusajs/admin-shared": "2.14.2",
    "@medusajs/cli": "2.14.2",
    "@medusajs/framework": "2.14.2",
    "@medusajs/medusa": "2.14.2",
    "@medusajs/types": "2.14.2",
    "@medusajs/utils": "2.14.2",
    "bcrypt": "^6.0.0",
    "bwip-js": "^4.10.1",
    "medusa-odoo": "workspace:*",
    "medusa-product-ext": "workspace:*",
    "medusa-qr": "workspace:*",
    "medusa-social-commerce": "workspace:*",
    "medusa-stories": "workspace:*",
    "medusa-barcode": "workspace:*",
    "nanoid": "^5.1.9",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.1",
    "@types/node": "^20",
    "@types/qs": "^6.15.0",
    "dotenv-cli": "^11.0.0",
    "typescript": "^5",
    "yalc": "1.0.0-pre.53"
  }
}
