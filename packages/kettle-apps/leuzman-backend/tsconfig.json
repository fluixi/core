{
  "compilerOptions": {
    "target":        "ES2021",
    "module":        "node16",
    "lib":           ["ES2021"],
    "moduleResolution": "node16",
    // "preserveSymlinks": true,
    "esModuleInterop": true,
    "strict":        false,
    "skipLibCheck":  true,
    "resolveJsonModule": true,
    "rootDir":       ".",
    "outDir":        ".medusa/server",
    "declaration":   true,
    "incremental":   false,
    "allowJs":       true,
    "emitDecoratorMetadata": false,
    "experimentalDecorators": false,
    "types": ["express", "express-serve-static-core", "qs"],
    "paths": {
      "#/*": ["./src/*"]
    }
  },
  
  "include":  ["src", "medusa-config.ts"],
  "exclude":  ["node_modules", ".medusa", "dist"]
}
