{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": [
      "dom",
      "DOM.Iterable",
      "es2021"
    ],
    "types": [
      "node"
    ],
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "preserve",
    "jsxImportSource": "@awc/kettlejs",
    "customConditions": [
      "development"
    ]
  },
  "include": [
    "src"
  ]
}
