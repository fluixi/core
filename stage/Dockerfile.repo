# --- STAGE 1: Build ---
FROM node:22-alpine AS builder
RUN apk add --no-cache python3 make g++
RUN npm install -g pnpm dotenv-cli

WORKDIR /app

# 1. Copy Monorepo Root Files
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./

# 2. Copy the Medusa Package Manifest (must match your path)
# This allows pnpm to calculate the dependency graph for this specific app
COPY packages/kettle-apps/leuzman-backend/package.json ./packages/kettle-apps/leuzman-backend/

# 3. Install dependencies for the Medusa app only
# If you fixed the lockfile locally, use --frozen-lockfile. 
# If not, use --no-frozen-lockfile to force a re-sync inside Docker.
RUN pnpm install --filter ./packages/kettle-apps/leuzman-backend --frozen-lockfile

# 4. Copy the entire source code (needed for the build)
COPY . .

# 5. Build the Medusa project
WORKDIR /app/packages/kettle-apps/leuzman-backend
RUN pnpm run build

# --- STAGE 2: Runner ---
FROM node:20-alpine AS runner
RUN npm install -g pnpm dotenv-cli
WORKDIR /app

# In Medusa v2, the build output is a standalone production folder
COPY --from=builder /app/packages/kettle-apps/leuzman-backend/.medusa/server ./
COPY --from=builder /app/packages/kettle-apps/leuzman-backend/start-prod.sh ./
COPY --from=builder /app/packages/kettle-apps/leuzman-backend/pnpm-lock.yaml ./

# Install only production dependencies for the compiled app
RUN pnpm install --prod

ENV NODE_ENV=production
# Force SSL off if your VPS DB doesn't support it
# DATABASE_URL should include ?sslmode=disable
EXPOSE 9000 5173

RUN chmod +x start-prod.sh
ENTRYPOINT ["./start-prod.sh"]